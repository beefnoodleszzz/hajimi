# Optional project root override; never put credentials here.
HAJIMI_ROOT=/absolute/path/to/hajimi

# Optional executable overrides for local installations.
HAJIMI_FFMPEG=ffmpeg
HAJIMI_FFPROBE=ffprobe
HAJIMI_SCENEDETECT=scenedetect

# Remote H3 access; secrets and SSH private keys remain in the shell/SSH config.
HAJIMI_H3_HOST=autodl-ssh-alias
HAJIMI_H3_USER=root
HAJIMI_H3_SSH_PORT=22
